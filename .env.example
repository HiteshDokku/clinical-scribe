# ── Network ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=clinical-scribe
GATEWAY_PORT=8000
WEB_PORT=5173

# ── Postgres ───────────────────────────────────────────────
# postgres container superuser — owns the DB and all tables.
# Alembic migrations run as this user so GRANT/REVOKE on
# scribe_app are effective (owners are immune to their own REVOKE).
POSTGRES_SUPERUSER_PASSWORD=postgres_admin_secret
# Application role — restricted: INSERT+SELECT only on audit_log.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clinical_scribe
POSTGRES_USER=scribe_app          # least-privilege role, no DELETE on audit_log
POSTGRES_PASSWORD=changeme_in_local_env_only

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
TRANSCRIPT_TTL_SECONDS=3600

# ── ASR ────────────────────────────────────────────────────
WHISPER_MODEL=small               # small|medium|large-v3
ASR_MAX_BUFFER_SECONDS=60

# ── LLM ────────────────────────────────────────────────────
LLM_BACKEND=llamacpp               # llamacpp|vllm
LLM_MODEL_NAME=llama-3-8b-instruct
LLM_QUANT=Q4_K_M
LLM_ENDPOINT=http://llm:8080/v1

# ── FHIR gateway — the ONLY service allowed external egress ─
FHIR_ALLOWLIST_HOST=hapi-fhir.internal.hospital.example
FHIR_ALLOWLIST_PORT=8443
FHIR_MTLS_CERT_PATH=/run/secrets/fhir_client_cert.pem
FHIR_MTLS_KEY_PATH=/run/secrets/fhir_client_key.pem

# ── Safety / drug data (local dictionary — no external calls) ─
DRUG_DICTIONARY_PATH=/data/drugs/ingredient_dictionary.csv
BRAND_MAP_PATH=/data/drugs/brand_map.csv
FUZZY_MATCH_MIN_CONFIDENCE=0.72

# ── Retention (ADR-0002) ─────────────────────────────────────
TRANSCRIPT_RETENTION_DEFAULT=off   # off|opt_in
AUDIO_RETENTION=never              # must always be "never" — not configurable in prod

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=info
REDACT_CLINICAL_TEXT_IN_LOGS=true  # must always be true — enforced by CI test
